# ============================================================
# env.test.example
# 保存後速度改善の実機テスト用・環境設定の見本
#
# 【使い方】
# このファイルはテスト専用の別作業フォルダ（本番用の
# apexia-app-fixed とは別ディレクトリ）にコピーし、
# ファイル名を「.env.local」に変更してから、
# テスト専用Supabaseプロジェクトの値だけを書き込んでください。
#
# 【重要】
# ・値は一切書き込んでいません（キー名のみの見本です）
# ・本番用の .env.local には絶対にこの内容を上書きしないでください
# ・本番のURL・キー・パスワード・トークンをここに書かないでください
# ・記入後のファイルは Git 管理に含めない（.gitignore 対象のまま）でください
# ============================================================

# テスト用WebアプリのURL（例: http://localhost:3000 など、本番URLとは異なるもの）
NEXT_PUBLIC_APP_URL=

# テスト専用Supabaseプロジェクトの Project URL
# （Supabaseダッシュボード → Project Settings → API で確認できます。
#   本番プロジェクトのURLとは異なることを必ず確認してください）
NEXT_PUBLIC_SUPABASE_URL=

# テスト専用Supabaseプロジェクトの anon / public キー
# （同じくProject Settings → API で確認できます）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
